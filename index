<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DeepGuard — AI Deepfake Detection</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #080b10;
    --bg2: #0e1219;
    --bg3: #141820;
    --border: rgba(255,255,255,0.07);
    --border2: rgba(255,255,255,0.12);
    --text: #e8eaf0;
    --muted: #7a8090;
    --accent: #00e5b0;
    --accent2: #0099ff;
    --danger: #ff4757;
    --warn: #ffa502;
    --safe: #2ed573;
    --font-head: 'Syne', sans-serif;
    --font-body: 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Scanline texture */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,229,176,0.012) 2px, rgba(0,229,176,0.012) 4px);
    pointer-events: none;
    z-index: 0;
  }

  /* NAV */
  nav {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 2.5rem; height: 60px;
    background: rgba(8,11,16,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 0.5px solid var(--border);
  }
  .logo {
    font-family: var(--font-head);
    font-size: 1.2rem; font-weight: 800; letter-spacing: -0.03em;
    display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text);
  }
  .logo-icon {
    width: 28px; height: 28px; border-radius: 6px;
    background: var(--accent);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; color: #080b10;
  }
  .nav-badge {
    font-family: var(--font-mono);
    font-size: 10px; color: var(--accent);
    border: 0.5px solid var(--accent);
    padding: 2px 8px; border-radius: 20px; letter-spacing: 0.05em;
  }
  .nav-right { display: flex; align-items: center; gap: 1.5rem; }
  .nav-link {
    font-size: 13px; color: var(--muted); text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text); }

  /* HERO */
  .hero {
    position: relative;
    text-align: center;
    padding: 5rem 2rem 3rem;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: -60px; left: 50%; transform: translateX(-50%);
    width: 600px; height: 300px;
    background: radial-gradient(ellipse at center, rgba(0,229,176,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px; color: var(--accent);
    border: 0.5px solid rgba(0,229,176,0.3);
    padding: 4px 12px; border-radius: 20px;
    margin-bottom: 1.5rem; letter-spacing: 0.08em;
    background: rgba(0,229,176,0.05);
  }
  h1 {
    font-family: var(--font-head);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800; line-height: 1.0;
    letter-spacing: -0.04em;
    color: #fff;
    margin-bottom: 1.2rem;
  }
  h1 span { color: var(--accent); }
  .hero-sub {
    font-size: 1rem; color: var(--muted); max-width: 480px; margin: 0 auto 2.5rem;
    line-height: 1.6; font-weight: 300;
  }

  /* STATS ROW */
  .stats-row {
    display: flex; justify-content: center; gap: 3rem;
    padding: 1.5rem 0 2rem;
    border-top: 0.5px solid var(--border);
    border-bottom: 0.5px solid var(--border);
    margin: 0 2.5rem 3rem;
  }
  .stat { text-align: center; }
  .stat-n {
    font-family: var(--font-head);
    font-size: 1.6rem; font-weight: 800; color: #fff;
  }
  .stat-n span { color: var(--accent); }
  .stat-l {
    font-size: 11px; color: var(--muted);
    font-family: var(--font-mono); letter-spacing: 0.06em;
    text-transform: uppercase; margin-top: 2px;
  }

  /* MAIN LAYOUT */
  .main {
    max-width: 1100px; margin: 0 auto; padding: 0 2rem 4rem;
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
  }

  /* PANELS */
  .panel {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .panel-header {
    padding: 1rem 1.25rem 0.75rem;
    border-bottom: 0.5px solid var(--border);
    display: flex; align-items: center; gap: 8px;
  }
  .panel-icon {
    width: 28px; height: 28px; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
  }
  .pi-teal { background: rgba(0,229,176,0.12); color: var(--accent); }
  .pi-blue { background: rgba(0,153,255,0.12); color: var(--accent2); }
  .pi-red  { background: rgba(255,71,87,0.12); color: var(--danger); }
  .panel-title {
    font-family: var(--font-head);
    font-size: 14px; font-weight: 700; color: #fff;
    letter-spacing: -0.01em;
  }
  .panel-subtitle { font-size: 11px; color: var(--muted); }
  .panel-body { padding: 1.25rem; }

  /* UPLOAD ZONE */
  .upload-zone {
    border: 1.5px dashed var(--border2);
    border-radius: 10px;
    padding: 2.5rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
    overflow: hidden;
  }
  .upload-zone:hover, .upload-zone.drag-over {
    border-color: var(--accent);
    background: rgba(0,229,176,0.04);
  }
  .upload-zone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .upload-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .upload-title { font-size: 15px; font-weight: 500; color: #fff; margin-bottom: 4px; }
  .upload-hint { font-size: 12px; color: var(--muted); font-family: var(--font-mono); }

  /* MEDIA TYPE TABS */
  .type-tabs {
    display: flex; gap: 6px; margin-bottom: 1rem;
  }
  .type-tab {
    flex: 1; padding: 7px 0;
    border: 0.5px solid var(--border);
    border-radius: 7px;
    background: transparent;
    color: var(--muted); font-size: 12px;
    font-family: var(--font-mono); letter-spacing: 0.04em;
    cursor: pointer; transition: all 0.2s;
  }
  .type-tab.active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0,229,176,0.08);
  }

  /* ANALYZE BUTTON */
  .analyze-btn {
    width: 100%; padding: 13px;
    border: none;
    background: var(--accent);
    color: #080b10;
    font-family: var(--font-head);
    font-size: 14px; font-weight: 700;
    border-radius: 8px; cursor: pointer;
    letter-spacing: 0.03em;
    transition: opacity 0.2s, transform 0.1s;
    margin-top: 1rem;
  }
  .analyze-btn:hover { opacity: 0.9; }
  .analyze-btn:active { transform: scale(0.99); }
  .analyze-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* SCORE DISPLAY */
  .score-display { text-align: center; padding: 1.5rem 0 1rem; }
  .score-ring-wrap {
    position: relative; width: 120px; height: 120px;
    margin: 0 auto 1rem;
  }
  .score-ring-wrap svg { transform: rotate(-90deg); }
  .score-number {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
  }
  .score-n {
    font-family: var(--font-head);
    font-size: 2rem; font-weight: 800; color: #fff;
  }
  .score-pct { font-size: 12px; color: var(--muted); font-family: var(--font-mono); }
  .verdict-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px; font-weight: 500;
    padding: 5px 14px; border-radius: 20px;
    letter-spacing: 0.06em;
  }
  .verdict-fake { background: rgba(255,71,87,0.15); color: var(--danger); border: 0.5px solid rgba(255,71,87,0.3); }
  .verdict-real { background: rgba(46,213,115,0.15); color: var(--safe); border: 0.5px solid rgba(46,213,115,0.3); }
  .verdict-sus  { background: rgba(255,165,2,0.15); color: var(--warn); border: 0.5px solid rgba(255,165,2,0.3); }

  /* BREAKDOWN BARS */
  .breakdown { margin-top: 1.2rem; }
  .breakdown-row { margin-bottom: 12px; }
  .breakdown-label {
    display: flex; justify-content: space-between;
    font-size: 12px; margin-bottom: 5px;
  }
  .breakdown-label span:first-child { color: var(--muted); font-family: var(--font-mono); }
  .breakdown-label span:last-child { color: #fff; font-weight: 500; }
  .bar-track {
    height: 5px; background: var(--bg3); border-radius: 3px; overflow: hidden;
  }
  .bar-fill {
    height: 100%; border-radius: 3px;
    transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
    width: 0%;
  }
  .bar-danger { background: var(--danger); }
  .bar-warn   { background: var(--warn); }
  .bar-safe   { background: var(--safe); }
  .bar-accent { background: var(--accent); }

  /* HEATMAP PANEL */
  .heatmap-canvas {
    width: 100%; border-radius: 8px;
    background: var(--bg3);
    overflow: hidden; position: relative;
  }
  #heatmap-canvas { width: 100%; display: block; }
  .heatmap-legend {
    display: flex; align-items: center; gap: 8px;
    margin-top: 10px; font-size: 11px; color: var(--muted);
    font-family: var(--font-mono);
  }
  .legend-grad {
    flex: 1; height: 6px; border-radius: 3px;
    background: linear-gradient(to right, rgba(0,229,176,0.3), #ffa502, #ff4757);
  }

  /* DETAILS PANEL — full width */
  .panel-full { grid-column: 1 / -1; }

  /* SIGNAL TABLE */
  .signal-table { width: 100%; border-collapse: collapse; }
  .signal-table th {
    text-align: left; font-size: 11px; color: var(--muted);
    font-family: var(--font-mono); letter-spacing: 0.06em;
    padding: 0 0 10px; border-bottom: 0.5px solid var(--border);
    font-weight: 400;
  }
  .signal-table td {
    padding: 10px 0; border-bottom: 0.5px solid var(--border);
    font-size: 13px; vertical-align: middle;
  }
  .signal-table tr:last-child td { border-bottom: none; }
  .signal-name { color: #fff; font-weight: 500; }
  .signal-desc { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .signal-conf {
    font-family: var(--font-mono); font-size: 12px; text-align: right;
  }
  .conf-high { color: var(--danger); }
  .conf-med  { color: var(--warn); }
  .conf-low  { color: var(--safe); }

  .dot {
    display: inline-block; width: 7px; height: 7px;
    border-radius: 50%; margin-right: 6px; vertical-align: middle;
  }
  .dot-red    { background: var(--danger); }
  .dot-yellow { background: var(--warn); }
  .dot-green  { background: var(--safe); }

  /* LOADING STATE */
  .loading-overlay {
    position: absolute; inset: 0;
    background: rgba(8,11,16,0.85);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 16px; border-radius: 12px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s; z-index: 10;
  }
  .loading-overlay.active { opacity: 1; pointer-events: all; }
  .loading-bar {
    width: 200px; height: 3px; background: var(--bg3); border-radius: 2px; overflow: hidden;
  }
  .loading-fill {
    height: 100%; background: var(--accent); border-radius: 2px;
    animation: loadpulse 1.5s ease-in-out infinite;
  }
  @keyframes loadpulse {
    0% { width: 0%; margin-left: 0; }
    50% { width: 70%; margin-left: 0; }
    100% { width: 0%; margin-left: 100%; }
  }
  .loading-text { font-family: var(--font-mono); font-size: 12px; color: var(--accent); }

  /* PLACEHOLDER STATE */
  .placeholder-msg {
    text-align: center; padding: 3rem 1rem;
    color: var(--muted); font-size: 13px;
    font-family: var(--font-mono);
  }
  .placeholder-msg .big { font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.3; }

  /* TERMINAL LOG */
  .terminal {
    background: #04060a;
    border: 0.5px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    max-height: 140px; overflow-y: auto;
    line-height: 1.7;
  }
  .log-line { display: block; }
  .log-ts { color: var(--muted); }
  .log-ok  { color: var(--accent); }
  .log-err { color: var(--danger); }
  .log-warn { color: var(--warn); }
  .log-info { color: var(--accent2); }

  /* RESPONSIVE */
  @media (max-width: 700px) {
    .main { grid-template-columns: 1fr; }
    .panel-full { grid-column: 1; }
    .stats-row { gap: 1.5rem; flex-wrap: wrap; }
  }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

  /* FADE IN */
  .fade-in { animation: fadein 0.5s ease both; }
  @keyframes fadein { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* FILE PREVIEW */
  .file-preview {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px;
    background: var(--bg3); border-radius: 8px;
    margin-bottom: 10px;
  }
  .file-preview-icon { font-size: 20px; }
  .file-preview-name { font-size: 13px; color: #fff; font-weight: 500; }
  .file-preview-size { font-size: 11px; color: var(--muted); font-family: var(--font-mono); }
  .file-preview-rm {
    margin-left: auto; background: none; border: none;
    color: var(--muted); cursor: pointer; font-size: 16px;
    transition: color 0.2s;
  }
  .file-preview-rm:hover { color: var(--danger); }

  .model-badge {
    font-family: var(--font-mono); font-size: 10px;
    padding: 2px 7px; border-radius: 4px;
    background: rgba(0,153,255,0.12); color: var(--accent2);
    margin-left: auto;
  }

  /* DOWNLOAD BTN */
  .dl-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 7px;
    background: rgba(0,229,176,0.1);
    border: 0.5px solid rgba(0,229,176,0.3);
    color: var(--accent); font-size: 12px;
    font-family: var(--font-mono); text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }
  .dl-btn:hover { background: rgba(0,229,176,0.18); }
</style>
</head>
