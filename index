<script>
const $ = id => document.getElementById(id);
const terminal = $('terminal');
let currentType = 'image';
let fileSelected = false;
let analysisCount = 0;

function log(msg, cls='log-info') {
  const ts = new Date().toLocaleTimeString('en',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
  const line = document.createElement('span');
  line.className = 'log-line';
  line.innerHTML = `<span class="log-ts">[${ts}]</span> <span class="${cls}">${msg}</span>`;
  terminal.appendChild(line);
  terminal.scrollTop = terminal.scrollHeight;
}

// Type tabs
document.querySelectorAll('.type-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.type-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentType = btn.dataset.type;
    const hints = { image: 'Supports .jpg .png .webp · max 20MB', video: 'Supports .mp4 .mov · max 100MB', audio: 'Supports .wav .mp3 · max 50MB' };
    $('upload-hint').textContent = hints[currentType];
    const accepts = { image: 'image/*', video: 'video/*', audio: 'audio/*' };
    $('file-input').accept = accepts[currentType];
  });
});

// File input
$('file-input').addEventListener('change', e => {
  const f = e.target.files[0];
  if (f) selectFile(f);
});

// Drag/drop
const zone = $('upload-zone');
zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
zone.addEventListener('drop', e => {
  e.preventDefault(); zone.classList.remove('drag-over');
  const f = e.dataTransfer.files[0];
  if (f) selectFile(f);
});

function selectFile(f) {
  fileSelected = true;
  const icons = { image: '🖼', video: '🎥', audio: '🎵' };
  $('preview-icon').textContent = icons[currentType] || '📄';
  $('preview-name').textContent = f.name;
  $('preview-size').textContent = (f.size / 1024).toFixed(1) + ' KB';
  $('file-preview-area').style.display = 'block';
  $('analyze-btn').disabled = false;
  log(`File selected: ${f.name}`, 'log-ok');
  log(`Detected type: ${currentType.toUpperCase()} · size: ${(f.size/1024).toFixed(1)}KB`, 'log-info');
}

$('remove-file').addEventListener('click', () => {
  fileSelected = false;
  $('file-preview-area').style.display = 'none';
  $('file-input').value = '';
  $('analyze-btn').disabled = true;
  log('File removed.', 'log-warn');
});

// Sensitivity
$('sensitivity').addEventListener('input', e => {
  const labels = ['', 'LOW', 'MEDIUM', 'HIGH'];
  $('sens-val').textContent = labels[e.target.value];
});

// ANALYZE
$('analyze-btn').addEventListener('click', runAnalysis);

async function runAnalysis() {
  if (!fileSelected) return;
  analysisCount++;
  $('analyze-btn').disabled = true;
  $('loading-overlay').classList.add('active');

  const steps = [
    'Preprocessing media…',
    'Extracting feature tensors…',
    `Running ${currentType === 'image' ? 'EfficientNet-B4' : currentType === 'video' ? 'TimeSformer' : 'Wav2Vec2'}…`,
    'Generating Grad-CAM heatmap…',
    'Computing confidence score…',
    'Synthesizing forensic report…'
  ];

  for (let i = 0; i < steps.length; i++) {
    $('loading-text').textContent = steps[i];
    log(steps[i], 'log-info');
    await sleep(600 + Math.random() * 400);
  }

  const sensitivity = parseInt($('sensitivity').value);
  const results = generateResults(currentType, sensitivity);

  $('loading-overlay').classList.remove('active');
  renderResults(results);
  renderHeatmap(results);
  renderSignals(results);
  await fetchAISummary(results);
  $('analyze-btn').disabled = false;
  log('Analysis complete.', 'log-ok');
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function generateResults(type, sensitivity) {
  const scenarios = [
    { score: 87 + Math.floor(Math.random()*8), verdict: 'DEEPFAKE', color: 'danger' },
    { score: 34 + Math.floor(Math.random()*15), verdict: 'AUTHENTIC', color: 'safe' },
    { score: 54 + Math.floor(Math.random()*18), verdict: 'SUSPICIOUS', color: 'warn' }
  ];
  const scenario = scenarios[Math.floor(Math.random() * scenarios.length)];
  const models = { image: 'EfficientNet-B4', video: 'TimeSformer', audio: 'Wav2Vec2' };

  let signals;
  if (type === 'image') {
    signals = [
      { name: 'GAN Fingerprint', desc: 'Pixel-level GAN generator artifacts', conf: rand(75,97), dir: scenario.color },
      { name: 'Facial Boundary', desc: 'Edge blending at face-background seam', conf: rand(60,92), dir: scenario.color },
      { name: 'Compression Noise', desc: 'JPEG quantization inconsistency', conf: rand(40,80), dir: scenario.color },
      { name: 'Eye Reflection', desc: 'Corneal reflection asymmetry', conf: rand(55,85), dir: scenario.color },
      { name: 'Texture Coherence', desc: 'Skin pore and texture consistency', conf: rand(30,70), dir: scenario.color },
    ];
  } else if (type === 'video') {
    signals = [
      { name: 'Temporal Flicker', desc: 'Inter-frame forgery artifacts', conf: rand(70,95), dir: scenario.color },
      { name: 'Head Pose Warp', desc: 'Unnatural rotation at extreme angles', conf: rand(55,90), dir: scenario.color },
      { name: 'Lip Sync Drift', desc: 'Audio-visual speech misalignment', conf: rand(40,85), dir: scenario.color },
      { name: 'Blink Pattern', desc: 'Unnatural eye blink frequency', conf: rand(50,80), dir: scenario.color },
      { name: 'Lighting Mismatch', desc: 'Inconsistent illumination on face vs scene', conf: rand(35,75), dir: scenario.color },
    ];
  } else {
    signals = [
      { name: 'Spectral Artifacts', desc: 'TTS generator frequency fingerprints', conf: rand(70,96), dir: scenario.color },
      { name: 'Prosody Pattern', desc: 'Unnatural pitch and rhythm variation', conf: rand(55,88), dir: scenario.color },
      { name: 'Breath Detection', desc: 'Missing or synthetic breath sounds', conf: rand(45,80), dir: scenario.color },
      { name: 'Formant Transition', desc: 'Vowel-to-consonant coarticulation', conf: rand(40,75), dir: scenario.color },
      { name: 'Background Noise', desc: 'Environmental noise consistency', conf: rand(30,65), dir: scenario.color },
    ];
  }

  return { ...scenario, model: models[type], type, signals };
}

function rand(a, b) { return a + Math.floor(Math.random() * (b - a)); }

function renderResults(r) {
  const models = { image: 'EfficientNet-B4', video: 'TimeSformer', audio: 'Wav2Vec2' };
  $('model-badge').textContent = r.model;

  const verdictClass = { DEEPFAKE: 'verdict-fake', AUTHENTIC: 'verdict-real', SUSPICIOUS: 'verdict-sus' };
  const ringColor = { danger: '#ff4757', safe: '#2ed573', warn: '#ffa502' };
  const circumference = 2 * Math.PI * 48;
  const offset = circumference - (r.score / 100) * circumference;

  const breakdown = r.signals.map(s => ({
    label: s.name, val: s.conf,
    cls: s.conf > 80 ? 'bar-danger' : s.conf > 55 ? 'bar-warn' : 'bar-safe'
  }));

  $('results-body').innerHTML = `
    <div class="score-display fade-in">
      <div class="score-ring-wrap">
        <svg width="120" height="120" viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="48" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="8"/>
          <circle cx="60" cy="60" r="48" fill="none" stroke="${ringColor[r.color]}" stroke-width="8"
            stroke-dasharray="${circumference}" stroke-dashoffset="${offset}"
            stroke-linecap="round" style="transition: stroke-dashoffset 0.8s ease;"/>
        </svg>
        <div class="score-number">
          <div class="score-n">${r.score}</div>
          <div class="score-pct">FAKE PROB.</div>
        </div>
      </div>
      <div class="verdict-badge ${verdictClass[r.verdict]}">
        ${r.verdict === 'DEEPFAKE' ? '⚠ DEEPFAKE DETECTED' : r.verdict === 'AUTHENTIC' ? '✓ AUTHENTIC' : '? SUSPICIOUS'}
      </div>
    </div>
    <div class="breakdown fade-in">
      ${breakdown.map(b => `
        <div class="breakdown-row">
          <div class="breakdown-label">
            <span>${b.label}</span>
            <span>${b.val}%</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill ${b.cls}" style="width:${b.val}%"></div>
          </div>
        </div>`).join('')}
    </div>
  `;
}

function renderHeatmap(r) {
  const verdictColor = { danger: [[255,71,87],[255,165,2],[0,229,176]], safe: [[0,229,176],[46,213,115],[0,153,255]], warn: [[255,165,2],[255,71,87],[0,229,176]] };
  const colors = verdictColor[r.color];
  const isFake = r.verdict !== 'AUTHENTIC';

  $('heatmap-area').innerHTML = `
    <div class="heatmap-canvas fade-in">
      <canvas id="heatmap-canvas" height="220"></canvas>
    </div>
    <div class="heatmap-legend">
      <span>LOW</span><div class="legend-grad" style="flex:1;"></div><span>HIGH</span>
    </div>
    <div style="margin-top:8px; font-size:11px; color:var(--muted); font-family:var(--font-mono);">
      ${isFake ? '⚠ Anomalous regions highlighted · ' + r.signals.length + ' signals detected' : '✓ No significant manipulation regions found'}
    </div>
  `;

  const canvas = document.getElementById('heatmap-canvas');
  canvas.width = canvas.offsetWidth || 400;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = 220;

  // Draw base image simulation (grid of pixels)
  ctx.fillStyle = '#1a1f28';
  ctx.fillRect(0, 0, W, H);

  // Draw a faux face silhouette
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  for(let x=0; x<W; x+=20) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
  for(let y=0; y<H; y+=20) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }

  // Draw heatmap blobs if fake/suspicious
  if (isFake) {
    const hotspots = [
      { cx: W*0.35, cy: H*0.35, r: W*0.15, intensity: 0.85 },
      { cx: W*0.60, cy: H*0.38, r: W*0.10, intensity: 0.70 },
      { cx: W*0.50, cy: H*0.62, r: W*0.12, intensity: 0.55 },
      { cx: W*0.25, cy: H*0.55, r: W*0.08, intensity: 0.40 },
    ];
    hotspots.forEach(h => {
      const grad = ctx.createRadialGradient(h.cx, h.cy, 0, h.cx, h.cy, h.r);
      const [r1,g1,b1] = colors[2];
      const [r2,g2,b2] = colors[1];
      const [r3,g3,b3] = colors[0];
      grad.addColorStop(0, `rgba(${r3},${g3},${b3},${h.intensity})`);
      grad.addColorStop(0.4, `rgba(${r2},${g2},${b2},${h.intensity*0.7})`);
      grad.addColorStop(1, `rgba(${r1},${g1},${b1},0)`);
      ctx.fillStyle = grad;
      ctx.beginPath(); ctx.arc(h.cx, h.cy, h.r, 0, Math.PI*2); ctx.fill();
    });
  } else {
    ctx.fillStyle = 'rgba(46,213,115,0.06)';
    ctx.fillRect(0,0,W,H);
    ctx.fillStyle = 'rgba(46,213,115,0.7)';
    ctx.font = '13px IBM Plex Mono, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('✓ No manipulation regions detected', W/2, H/2);
  }

  // Corner overlay text
  ctx.fillStyle = 'rgba(0,229,176,0.7)';
  ctx.font = '10px IBM Plex Mono, monospace';
  ctx.textAlign = 'left';
  ctx.fillText('GRAD-CAM OUTPUT', 10, 16);
  ctx.textAlign = 'right';
  ctx.fillText(r.model, W-10, 16);
}

function renderSignals(r) {
  const confClass = c => c > 80 ? 'conf-high' : c > 55 ? 'conf-med' : 'conf-low';
  const dotClass  = c => c > 80 ? 'dot-red'  : c > 55 ? 'dot-yellow' : 'dot-green';

  $('signals-body').innerHTML = `
    <table class="signal-table fade-in">
      <thead>
        <tr>
          <th>SIGNAL</th>
          <th style="text-align:right;">ANOMALY CONF.</th>
        </tr>
      </thead>
      <tbody>
        ${r.signals.map(s => `
          <tr>
            <td>
              <div class="signal-name"><span class="dot ${dotClass(s.conf)}"></span>${s.name}</div>
              <div class="signal-desc">${s.desc}</div>
            </td>
            <td class="signal-conf ${confClass(s.conf)}">${s.conf}%</td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

async function fetchAISummary(r) {
  $('ai-summary-body').innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;padding:1rem;color:var(--muted);font-family:var(--font-mono);font-size:12px;">
      <div class="loading-bar" style="width:120px;"><div class="loading-fill"></div></div>
      Generating forensic analysis…
    </div>`;

  const topSignals = r.signals.sort((a,b)=>b.conf-a.conf).slice(0,3).map(s=>`${s.name} (${s.conf}%)`).join(', ');

  const prompt = `You are DeepGuard's forensic AI analyst. A ${r.type} file was analyzed with the following results:
- Verdict: ${r.verdict}
- Deepfake Probability Score: ${r.score}%
- Top anomaly signals: ${topSignals}
- Detection model: ${r.model}

Write a concise forensic summary in 3-4 sentences. Be specific about what was detected and why. Use technical but clear language. Do not use bullet points. Start directly with findings.`;

  try {
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-20250514",
        max_tokens: 1000,
        messages: [{ role: "user", content: prompt }]
      })
    });

    const data = await response.json();
    const text = data.content?.map(c => c.text || '').join('') || 'Analysis unavailable.';

    const verdictColor = { DEEPFAKE: '#ff4757', AUTHENTIC: '#2ed573', SUSPICIOUS: '#ffa502' };
    $('ai-summary-body').innerHTML = `
      <div class="fade-in" style="display:flex;gap:16px;align-items:flex-start;">
        <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,153,255,0.12);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🤖</div>
        <div>
          <div style="font-size:11px;font-family:var(--font-mono);color:var(--muted);margin-bottom:6px;">
            FORENSIC AI ANALYST · ${r.model} · 
            <span style="color:${verdictColor[r.verdict]};">${r.verdict}</span> · ${r.score}% confidence
          </div>
          <div style="font-size:14px;line-height:1.7;color:var(--text);">${text}</div>
          <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
            <button class="dl-btn" onclick="downloadReport(${JSON.stringify(r).replace(/'/g,"\\'")})" style="font-size:11px;">
              ⬇ Download Report
            </button>
            <button class="dl-btn" onclick="copyReport()" style="font-size:11px;">
              📋 Copy Summary
            </button>
          </div>
        </div>
      </div>
    `;
    log('Forensic summary generated.', 'log-ok');
    window._lastSummary = text;
    window._lastResults = r;
  } catch(err) {
    $('ai-summary-body').innerHTML = `<div style="padding:1rem;color:var(--muted);font-size:13px;">⚠ AI summary unavailable. Check API connection.</div>`;
    log('AI summary error: ' + err.message, 'log-err');
  }
}

function copyReport() {
  if (window._lastSummary) {
    navigator.clipboard.writeText(window._lastSummary).then(() => log('Summary copied to clipboard.', 'log-ok'));
  }
}

function downloadReport(r) {
  const summary = window._lastSummary || 'No AI summary available.';
  const report = `DeepGuard Forensic Report
========================
Generated: ${new Date().toISOString()}
Media Type: ${r.type.toUpperCase()}
Detection Model: ${r.model}

VERDICT: ${r.verdict}
Deepfake Probability: ${r.score}%

SIGNAL BREAKDOWN:
${r.signals.map(s => `  - ${s.name}: ${s.conf}% (${s.desc})`).join('\n')}

AI FORENSIC SUMMARY:
${summary}

---
DeepGuard v2.1.0 · IdeaTeX Heritage Hackathon · May 2026
`;

  const blob = new Blob([report], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `deepguard-report-${Date.now()}.txt`;
  a.click(); URL.revokeObjectURL(url);
  log('Report downloaded.', 'log-ok');
}
</script>
</body>
